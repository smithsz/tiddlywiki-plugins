.tc-tiddler-frame[data-tiddler-title="Bookmarks"]{padding:7px 12px !important;}
.tc-tiddler-frame[data-tiddler-title="Bookmarks"] .tc-tiddler-title .tc-titlebar,
.tc-tiddler-frame[data-tiddler-title="Bookmarks"] .tc-subtitle,
.tc-tiddler-frame[data-tiddler-title="Bookmarks"] .tc-tiddler-subtitle,
.tc-tiddler-frame[data-tiddler-title="Bookmarks"] .tc-tags-wrapper{display:none !important;}
.tc-tiddler-frame[data-tiddler-title="Bookmarks"] .tc-tiddler-body{margin:0;font-size:1em;}
.tc-tiddler-frame[data-tiddler-title="Bookmarks"] .tc-tiddler-body > p{margin:0;}
.tc-tiddler-frame[data-tiddler-title="Bookmarks"] .tc-tiddler-controls{position:absolute;right:12px;top:7px;z-index:5;opacity:0;transition:opacity .2s;}
.tc-tiddler-frame[data-tiddler-title="Bookmarks"]:hover .tc-tiddler-controls{opacity:.8;}

.bm-bar{display:flex;align-items:center;gap:6px;min-width:0;font-size:12.5px;line-height:16px;}
.bm-bar-items{display:flex;align-items:center;gap:1px;flex:1 1 auto;min-width:0;overflow-x:auto;overflow-y:hidden;padding-bottom:1px;scrollbar-width:thin;}
.bm-bar-items::-webkit-scrollbar{height:5px;}
.bm-bar-items::-webkit-scrollbar-track{background:transparent;}
.bm-bar-items::-webkit-scrollbar-thumb{background:rgba(127,127,127,.3);border-radius:3px;}

.bm-item{display:inline-flex;align-items:center;gap:7px;flex:0 0 auto;max-width:190px;margin:0;padding:4px 8px;border:none;border-radius:6px;background:transparent;color:inherit;font:inherit;font-size:12.5px;line-height:16px;text-align:left;text-decoration:none;white-space:nowrap;cursor:pointer;}
.bm-item:hover,.bm-item:focus-visible{background:rgba(127,127,127,.18);text-decoration:none;}
.bm-item.tc-tiddlylink,.bm-item.tc-tiddlylink:hover,a.bm-item,a.bm-item:hover{color:inherit;}
.bm-item .bm-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.bm-folder-open{background:rgba(127,127,127,.14);}

.bm-ico{flex:0 0 16px;width:16px;height:16px;border-radius:4px;display:inline-flex;align-items:center;justify-content:center;overflow:hidden;background-repeat:no-repeat;background-position:center center;background-size:16px 16px;color:#fff;font-size:9.5px;font-weight:700;}
.bm-ico-folder{border-radius:0;color:inherit;}
.bm-folder-svg{width:16px;height:16px;fill:currentColor;opacity:.62;}

.bm-bar-tools{display:flex;align-items:center;gap:2px;flex:0 0 auto;opacity:0;transition:opacity .15s;}
.bm-bar:hover .bm-bar-tools,.bm-bar:focus-within .bm-bar-tools{opacity:1;}
.bm-tool{width:24px;height:24px;padding:0;border:none;border-radius:6px;background:transparent;color:inherit;font-size:14px;line-height:1;opacity:.6;cursor:pointer;}
.bm-tool:hover{opacity:1;background:rgba(127,127,127,.18);}

.bm-hint,.bm-empty{padding:4px 8px;font-size:12px;opacity:.6;}

.bm-menu{min-width:215px;max-width:340px;max-width:min(340px,calc(100vw - 32px));max-height:62vh;overflow-y:auto;padding:5px;border-radius:9px;background:#fff;background:<<colour dropdown-background>>;color:inherit;color:<<colour foreground>>;border:1px solid rgba(127,127,127,.26);box-shadow:0 12px 30px -12px rgba(0,0,0,.55);}
.bm-menu .bm-row{display:flex;width:100%;max-width:none;box-sizing:border-box;padding:6px 8px;border-radius:5px;}
.bm-sub{display:block;}
.bm-submenu{margin:1px 0 3px 12px;padding-left:9px;border-left:1px solid rgba(127,127,127,.22);}
.bm-caret{margin-left:auto;padding-left:8px;opacity:.5;transition:transform .12s ease;}
.bm-caret-open{transform:rotate(90deg);}

.bm-pop{width:306px;max-width:calc(100vw - 32px);padding:12px;border-radius:9px;background:#fff;background:<<colour dropdown-background>>;color:inherit;color:<<colour foreground>>;border:1px solid rgba(127,127,127,.26);box-shadow:0 12px 30px -12px rgba(0,0,0,.55);}
.bm-pop-head{margin-bottom:9px;font-size:10.5px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;opacity:.6;}
.bm-pop-note{margin:2px 0 9px;font-size:11px;opacity:.6;}
.bm-pop-actions{display:flex;justify-content:flex-end;gap:7px;margin-top:10px;}
.bm-field{display:flex;flex-direction:column;gap:3px;margin-bottom:9px;font-size:12px;}
.bm-field-label{opacity:.62;}
.bm-check{display:flex;align-items:center;gap:6px;}
.bm-input{width:100%;box-sizing:border-box;padding:5px 8px;border:1px solid rgba(127,127,127,.34);border-radius:5px;background:transparent;color:inherit;font:inherit;font-size:12.5px;}
.bm-input:focus{outline:none;border-color:#5778d8;border-color:<<colour primary>>;}
.bm-chip{margin:0 4px 5px 0;padding:2px 8px;border:1px solid rgba(127,127,127,.3);border-radius:11px;background:transparent;color:inherit;font-size:11px;cursor:pointer;}
.bm-chip:hover{background:rgba(127,127,127,.16);}
.bm-btn{padding:5px 13px;border:1px solid rgba(127,127,127,.34);border-radius:6px;background:transparent;color:inherit;font-size:12.5px;cursor:pointer;}
.bm-btn-primary{background:#5778d8;background:<<colour primary>>;border-color:#5778d8;border-color:<<colour primary>>;color:#fff;}
.bm-dim{opacity:.55;}

.bm-manager{max-width:900px;}
.bm-manager .bm-panel{max-width:420px;margin:4px 0 10px;padding:12px;border:1px solid rgba(127,127,127,.22);border-radius:9px;}
.bm-mgroup-head{display:flex;align-items:center;gap:7px;margin:22px 0 5px;font-size:12.5px;font-weight:600;}
.bm-mgroup-name{opacity:.85;}
.bm-mrow{display:flex;align-items:center;gap:7px;padding:5px 0;border-bottom:1px solid rgba(127,127,127,.14);}
.bm-mmove{display:flex;flex:0 0 auto;}
.bm-mrow .bm-input{width:auto;}
.bm-mrow .bm-input-name{flex:1 1 28%;min-width:80px;}
.bm-mrow .bm-input-url{flex:2 1 44%;min-width:110px;}
.bm-mfolder{flex:0 0 auto;max-width:150px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;padding:4px 8px;border:1px dashed rgba(127,127,127,.4);border-radius:5px;background:transparent;color:inherit;font-size:11.5px;cursor:pointer;}
.bm-mfolder:hover{background:rgba(127,127,127,.14);}
.bm-mbtn{flex:0 0 auto;padding:2px 5px;border:none;border-radius:4px;background:transparent;color:inherit;font-size:12px;line-height:1.2;opacity:.55;cursor:pointer;}
.bm-mbtn:hover{opacity:1;background:rgba(127,127,127,.18);}
.bm-mdel:hover{color:#c0392b;}
.bm-star{display:inline-block;}

@media (max-width:750px){
.bm-item{max-width:130px;}
.bm-bar-tools{opacity:1;}
.bm-mrow{flex-wrap:wrap;}
}

<$list filter="[[$:/config/bookmarks/labels]get[text]match[no]]" variable="bmnone">.bm-bar-items .bm-label{display:none;}
.bm-bar-items .bm-item{gap:0;padding:4px 6px;}
</$list>

\whitespace trim
<$vars bmurl={{{ [<bmitem>get[url]] }}} bmlabel={{{ [<bmitem>bookmarklabel[]] }}} bmclass={{{ [<bmmode>match[menu]then[bm-item bm-row]else[bm-item]] }}} bmnewtab={{{ [[$:/config/bookmarks/newtab]get[text]match[no]then[_self]else[_blank]] }}}>
<$list filter="[<bmurl>!match[]]" variable="bmhref">
<a class=<<bmclass>> href=<<bmhref>> target=<<bmnewtab>> rel="noopener noreferrer" title=<<bmhref>>><$transclude tiddler="$:/plugins/claude/bookmarks/templates/icon"/><span class="bm-label"><$text text=<<bmlabel>>/></span></a>
</$list>
<$list filter="[<bmurl>match[]]" variable="bmnone">
<$vars bmtarget={{{ [<bmitem>get[target]] }}}>
<$link to=<<bmtarget>> class=<<bmclass>> tooltip=<<bmtarget>>><$transclude tiddler="$:/plugins/claude/bookmarks/templates/icon"/><span class="bm-label"><$text text=<<bmlabel>>/></span></$link>
</$vars>
</$list>
</$vars>

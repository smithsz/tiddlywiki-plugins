\whitespace trim
<$list filter="[[$:/config/tasks/pagebadge]get[text]!match[no]]" variable="tknone">
<$vars tknow={{$:/temp/tasks/now}}>
<$vars tkoverdue={{{ [taskscope[]taskselect[overdue],<tknow>count[]] }}}>
<$button to="Tasks" tooltip={{{ [<tkoverdue>match[0]then[Open the task list]] ~[<tkoverdue>addprefix[Overdue tasks: ]] }}} aria-label="Tasks" class=<<tv-config-toolbar-class>>>
<span class="tk-glyph">◴</span>
<$list filter="[<tkoverdue>!match[0]]" variable="tknone"><span class="tk-pagebadge"><$text text=<<tkoverdue>>/></span></$list>
<$list filter="[<tv-config-toolbar-text>match[yes]]" variable="tknone"><span class="tc-btn-text">&#32;Tasks</span></$list>
</$button>
</$vars>
</$vars>
</$list>
